# Copy this file to .env in the project root before running
# `docker compose up --build`.
#
# -----------------------------------------------------------------------
# REQUIRED: Anthropic / Claude API key
# -----------------------------------------------------------------------
# PsychApp's chat (Agent 1) and linguistic-analysis (Agent 2) features are
# powered by Claude via the Anthropic API. There is no way to run "the
# Claude model" fully offline -- Anthropic does not distribute downloadable
# model weights -- so this call always goes out over the network. Every
# other part of the app (database, deterministic risk engine, web UI)
# runs entirely on your machine.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY= 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

# Model id used for both agents. Verify the current recommended model at
# https://docs.claude.com/en/docs/about-claude/models before deploying;
# the value below was current at build time but Anthropic periodically
# retires older dated model ids.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# -----------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------
# Any random 32+ character string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION

# -----------------------------------------------------------------------
# Database (docker-compose overrides this to point at the `db` service;
# only relevant if you run the backend outside Docker, see README)
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://psychapp:psychapp@localhost:5433/psychapp

# -----------------------------------------------------------------------
# Optional: outbound email for professional alert notifications
# (Level 3 / Level 4 alerts always work without this -- they always
# create an in-app notification; email is best-effort on top of that)
# -----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=psychapp@localhost

# -----------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------
APP_LOCALE=es-ES
APP_ENV=local
# Comma-separated. In APP_ENV=local the API also allows private LAN origins
# (e.g. http://192.168.x.x:5173) so a phone on the same Wi‑Fi can use the app.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Seeds 4 demo accounts (patient/therapist/supervisor/admin) + 21 days of
# synthetic check-ins on first startup so the app is explorable right
# away. Set to false once you have real data.
SEED_DEMO_DATA=true
