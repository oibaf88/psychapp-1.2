# Copy this file to .env in the project root before running
# `docker compose up --build`. Never commit the resulting .env.
#
# -----------------------------------------------------------------------
# REQUIRED: Anthropic / Claude API key
# -----------------------------------------------------------------------
# Both PsychDeep agents run on the Anthropic API:
#   Agent 1 — the conversational reply the patient reads
#   Agent 2 — the structured linguistic analysis feeding the risk engine
# There is no way to run Claude fully offline (Anthropic does not
# distribute model weights), so these calls always go out over the
# network. Everything else — database, deterministic risk engine, web UI —
# runs on infrastructure you control.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------
# Models — one per agent, so the analyst can be pinned independently
# -----------------------------------------------------------------------
# Agent 1: conversational. `effort` trades latency/cost against depth
# (low | medium | high | xhigh | max).
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_CHAT_EFFORT=medium

# Agent 2: linguistic analysis. Its output drives alert levels, so it
# defaults to high effort. Drop to `medium` only after checking your own
# evaluation set — this is the safety-critical path.
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
ANTHROPIC_ANALYSIS_EFFORT=high

# Caps thinking + response text together, so leave headroom.
ANTHROPIC_MAX_TOKENS=8192

# -----------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------
# Any random 32+ character string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
# Local Docker Compose overrides this to point at the `db` service; the
# value below only matters if you run the backend outside Docker.
DATABASE_URL=postgresql://psychapp:psychapp@localhost:5433/psychapp
#
# Supabase (production): copy the CONNECTION POOLER string from
# Supabase -> Connect. Do NOT use the direct db.<ref>.supabase.co host —
# it is IPv6-only and Render cannot reach it. Shape:
#   postgresql+psycopg2://USER:PASSWORD@<pooler-host>:5432/postgres?sslmode=require&options=-csearch_path%3Dpsychdeep_v12
#
# Tables go in `public` unless a schema is selected. On Supabase prefer a
# dedicated schema: `public` is exposed through PostgREST, a custom schema
# is not. Select it either with the `options=-csearch_path%3D<schema>`
# parameter above (%3D is an encoded `=`), or with DATABASE_SCHEMA below —
# one or the other, not both.
#
# The schema must already exist; create_all() creates tables, not schemas:
#   create schema if not exists psychdeep_v12;
DATABASE_SCHEMA=

# -----------------------------------------------------------------------
# Optional: outbound email for professional alert notifications
# (Level 3 / Level 4 alerts always work without this — they always create
# an in-app notification; email is best-effort on top of that)
# -----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=psychapp@localhost

# -----------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------
APP_LOCALE=es-ES
# /auth/google-login does NOT verify the token with Google — it trusts the
# client-supplied id_token as the user's email. Enabling this lets anyone
# obtain a session for any account. Leave false until real verification is
# implemented; the endpoint returns 501 while it is off.
ALLOW_MOCK_GOOGLE_LOGIN=false
# `local` also allows private LAN origins (e.g. http://192.168.x.x:5173) so
# a phone on the same Wi-Fi can reach the API. Use `production` when
# deployed — it restricts CORS to exactly the origins listed below.
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Seeds 4 demo accounts (patient/therapist/supervisor/admin) + 21 days of
# synthetic check-ins on first startup. Their passwords are well known —
# ALWAYS set this to false for any deployment reachable from the internet.
SEED_DEMO_DATA=true
