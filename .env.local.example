# PsychDeep local/offline profile. Copy to .env.local; never commit .env.local.

# Local database password. Change this before first startup if the laptop may
# be shared. The database is bound to 127.0.0.1 only.
LOCAL_DB_PASSWORD=CHANGE_ME_LOCAL_DB
DATABASE_SCHEMA=psychdeep_v12

# Auth for the local PsychDeep instance. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_WITH_64_RANDOM_HEX_CHARS
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=false
ALLOW_MOCK_GOOGLE_LOGIN=false

# Local/offline LLM mode. The backend can be pointed from Settings to
# http://host.docker.internal:1234/v1 when LM Studio runs on Windows.
LLM_ALLOW_RUNTIME_OVERRIDE=true

# Anthropic remains an optional fallback when internet is available.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_CHAT_EFFORT=medium
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
ANTHROPIC_ANALYSIS_EFFORT=high
ANTHROPIC_COPILOT_MODEL=
ANTHROPIC_COPILOT_EFFORT=
ANTHROPIC_MAX_TOKENS=8192

# Optional email; leave blank offline.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=psychapp@localhost
